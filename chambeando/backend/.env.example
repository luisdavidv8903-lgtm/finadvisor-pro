DATABASE_URL=postgresql://chambeando:changeme@localhost:5432/chambeando
SECRET_KEY=replace-with-a-random-64-char-secret-never-commit-the-real-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
NONCE_EXPIRE_SECONDS=300
CORS_ORIGINS=["https://app.chambeando.com"]

CHAIN_ADAPTER=tron
TRON_NODE_URL=https://api.shasta.trongrid.io
ESCROW_CONTRACT_ADDRESS=
ESCROW_CONTRACT_ABI_PATH=./contracts/EscrowP2P.abi.json
CONFIRMATIONS_REQUIRED=19
INDEXER_POLL_INTERVAL_SECONDS=5
INDEXER_MAX_BLOCK_RANGE=500

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA commitear el valor real — esto es solo un placeholder de ejemplo.
SETTLEMENT_ENCRYPTION_KEY=replace-with-a-real-fernet-key-never-commit-the-real-value

RATE_LIMIT_NONCE_PER_MINUTE=5
RATE_LIMIT_VERIFY_PER_MINUTE=10
RATE_LIMIT_INVITE_REDEEM_PER_MINUTE=5

# WhatsApp (Phase 2C/2D.1) — see backend/WHATSAPP_ARCHITECTURE.md.
# WHATSAPP_PROVIDER stays "sandbox" (never touches the network) unless
# explicitly set to "meta" — provider selection is config-driven, never
# inferred from whether the fields below happen to be set.
WHATSAPP_PROVIDER=sandbox
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-token-never-commit-the-real-value
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret-never-commit-the-real-value
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
RATE_LIMIT_WHATSAPP_MESSAGE_PER_MINUTE=20
